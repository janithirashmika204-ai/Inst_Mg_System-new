# Copy this file to .env.local and enter values from Supabase > Project Settings > API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Older Supabase projects may expose an anon key; use that instead if no publishable key is shown.
# VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
